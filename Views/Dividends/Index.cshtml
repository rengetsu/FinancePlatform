@model FinancePlatform.Models.ViewModels.DividendCalendarViewModel
@{
    ViewData["Title"] = "Dividends";
}

<h2>Dividends</h2>
<p class="text-muted">A sample dividend calendar with upcoming payments.</p>
<p><a class="btn btn-outline-primary" asp-controller="DividendCalculator" asp-action="Index">Calculate dividend income &rarr;</a></p>

<div class="alert alert-info">
    Demo data only. All companies, tickers, amounts, and dates below are fictional.
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <caption>Sample dividends. Amounts are per share in USD; dates use YYYY-MM-DD.</caption>
        <thead>
            <tr>
                <th scope="col">Ticker</th>
                <th scope="col">Company Name</th>
                <th scope="col" class="text-end">Dividend per Share (USD)</th>
                <th scope="col">Frequency</th>
                <th scope="col">Ex-Dividend Date</th>
                <th scope="col">Payment Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var dividend in Model.Dividends)
            {
                <tr>
                    <th scope="row">@dividend.Ticker</th>
                    <td>@dividend.CompanyName</td>
                    <td class="text-end">@dividend.AmountPerShare.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</td>
                    <td>@dividend.Frequency</td>
                    <td>@dividend.ExDividendDate.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td>@dividend.PaymentDate.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)</td>
                </tr>
            }
        </tbody>
    </table>
</div>
