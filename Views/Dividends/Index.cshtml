@model FinancePlatform.Models.ViewModels.DividendCalendarViewModel
@{
    ViewData["Title"] = "Dividends";
}

<partial name="_DataSource" model="Model.SourceStatus" />
<h2>Dividends</h2>
@if (Model.Dividends.Count == 0 && Model.SourceStatus.Error is null) { <div class="alert alert-info">No saved dividends yet. Fetch and save a dividend on the <a asp-controller="Stock" asp-action="StockView">API page</a>.</div> }
<p class="text-muted">Dividend calendar with recorded payment dates.</p>
<p><a class="btn btn-outline-primary" asp-controller="DividendCalculator" asp-action="Index" asp-route-source="@Model.SourceStatus.Source">Calculate dividend income &rarr;</a></p>

<div class="alert alert-info">
    @Model.SourceStatus.Description
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <caption>Dividends. Amounts are per share in USD; dates use YYYY-MM-DD.</caption>
        <thead>
            <tr>
                <th scope="col">Ticker</th>
                <th scope="col">Company Name</th>
                <th scope="col" class="text-end">Dividend per Share (USD)</th>
                <th scope="col">Frequency</th>
                <th scope="col">Ex-Dividend Date</th>
                <th scope="col">Payment Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var dividend in Model.Dividends)
            {
                <tr>
                    <th scope="row">@dividend.Ticker</th>
                    <td>@dividend.CompanyName</td>
                    <td class="text-end">@dividend.AmountPerShare.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</td>
                    <td>@dividend.Frequency</td>
                    <td>@dividend.ExDividendDate.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td>@dividend.PaymentDate.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)</td>
                </tr>
            }
        </tbody>
    </table>
</div>
