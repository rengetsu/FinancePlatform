@model FinancePlatform.Models.ViewModels.MarketImportViewModel
@using System.Globalization
@{ ViewData["Title"] = "Market Data Import"; }
<section class="market-page">
    <header class="market-heading"><div><span class="market-eyebrow">API IMPORT</span><h1>Fetch, preview, then save</h1><p>Retrieve provider data on demand. Nothing is saved until you choose Save to database.</p></div></header>
    <div class="alert alert-info">Stock prices are daily closing prices for the selected date. Dividend lookup returns the latest recurring dividend on or before that date. Provider access may be delayed or limited by your plan. Currency: USD.</div>
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    @if (Model.Message is not null) { <div class="alert alert-success" role="status">@Model.Message</div> }
    <form asp-action="SubmitStock" method="post" class="market-card p-4 mb-4">
        <div class="row g-3">
            <div class="col-md-4"><label asp-for="Input.Ticker" class="form-label">Ticker</label><input asp-for="Input.Ticker" class="form-control" placeholder="AAPL" /></div>
            <div class="col-md-4"><label asp-for="Input.Date" class="form-label">Date / dividend cutoff</label><input asp-for="Input.Date" type="date" class="form-control" /></div>
            <div class="col-md-4"><label asp-for="Input.Dividend" class="form-label">Data to retrieve</label><select asp-for="Input.Dividend" class="form-select"><option value="false">Daily stock close</option><option value="true">Latest recurring dividend</option></select></div>
        </div>
        <div><button type="submit" class="btn btn-primary mt-3">Fetch preview</button></div>
    </form>
    @if (Model.Preview is { } preview)
    {
        <div class="market-card p-4">
            <h2 class="h4">@preview.Ticker preview</h2>
            @if (preview.ClosePrice is { } price)
            {
                <p>Closing price on @preview.Date.ToString("yyyy-MM-dd"): <strong>@price.ToString("C2", CultureInfo.GetCultureInfo("en-US"))</strong></p>
            }
            @if (preview.Dividend is { } dividend)
            {
                <p>@dividend.AmountPerShare.ToString("C2", CultureInfo.GetCultureInfo("en-US")) per share · @dividend.Frequency</p>
                <p>Ex-dividend: @dividend.ExDividendDate.ToString("yyyy-MM-dd") · Payment: @dividend.PaymentDate.ToString("yyyy-MM-dd")</p>
            }
            @if (Model.Token is not null)
            {
                <form asp-action="AddToDatabase" method="post"><input type="hidden" name="token" value="@Model.Token" /><button type="submit" class="btn btn-success">Save to database</button></form>
            }
        </div>
    }
</section>